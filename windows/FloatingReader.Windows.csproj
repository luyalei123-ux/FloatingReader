<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion><UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>FloatingReader</AssemblyName><RootNamespace>FloatingReader.Windows</RootNamespace>
    <Version>0.29.2</Version><ApplicationIcon>Assets/App.ico</ApplicationIcon><ApplicationManifest>app.manifest</ApplicationManifest>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NoWarn>$(NoWarn);NETSDK1137</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Core/**/*.cs;Tests/**/*.cs"/>
    <ProjectReference Include="Core/FloatingReader.Core.csproj"/>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35"/>
    <Content Include="../macos/Resources/reader.js" Link="Resources/reader.js" CopyToOutputDirectory="PreserveNewest"/>
    <Content Include="../macos/Resources/Icons/*.png" Link="Resources/Icons/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"/>
    <Content Include="Resources/navigation.js" CopyToOutputDirectory="PreserveNewest"/>
    <Content Include="ThirdParty/*.txt" CopyToOutputDirectory="PreserveNewest"/>
    <Content Include="../macos/Resources/Icons/LICENSE" Link="ThirdParty/Feather-LICENSE.txt" CopyToOutputDirectory="PreserveNewest"/>
    <Content Include="Assets/App.ico" CopyToOutputDirectory="PreserveNewest"/>
    <Content Include="../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest"/>
    <Content Include="../THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>
</Project>
